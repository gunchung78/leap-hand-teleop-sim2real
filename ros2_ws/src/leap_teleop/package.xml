<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>leap_teleop</name>
  <version>0.1.0</version>
  <description>LEAP Hand v1 Lite webcam teleoperation: tracker / retarget / MuJoCo twin / safety bridge nodes.
    Algorithms live in the pure-python package leap_hand_mapping (pip install -e .); these nodes only wire topics.</description>
  <maintainer email="geonlee012@gmail.com">geon</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>std_msgs</depend>
  <depend>leap_hand</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
